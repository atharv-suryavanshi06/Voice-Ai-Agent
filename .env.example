# Required for microphone and Twilio voice operation
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Optional model and voice overrides
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SYSTEM_PROMPT=You are a helpful, friendly voice assistant. Keep replies short and conversational.
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
RAG_MIN_RELEVANCE_SCORE=0.05
RAG_COLLECTION_NAME=insurance_policies

# Optional PostgreSQL. DATABASE_URL takes precedence when set.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# Optional Twilio and public webhook exposure
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=
NGROK_AUTHTOKEN=
PORT=8765

# Optional LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Voice-AI-Agent
